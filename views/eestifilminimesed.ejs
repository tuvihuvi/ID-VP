<!DOCTYPE html>
<html lang="et">
<head>
    <meta charset="utf-8">
    <title>Roger Viidalepp, veebiprogrammeerimine</title>
    <style>
        body {
            background-color: rgb(186, 220, 255);
            font-family: sans-serif;
            margin: 20px;
        }
        nav {
            text-align: center;
            font-size: 24px;
            font-weight: bold;
            margin: 20px 0;
        }
        nav a {
            text-decoration: underline;
            color: rgb(255, 0, 132);
        }
    </style>
</head>
<body>

    <img src="/PICTURE/veebiprogrammeerimine_2026_ID.png" alt="Veebiprogrammeerimine bänner" style="display: block; margin: 0 auto;">

    <nav>
        <a href="/">Avaleht</a> |
        <a href="/vanasona">Vanasõna</a> |
        <a href="/minust">Minust</a> |
        <a href="/eestifilm">Eesti film</a> |
        <a href="/viimane">Viimane külastus</a>
    </nav>

	<h1>Eesti filmiga seotud inimesed</h1>
	<ul>
		<li><a href="/">Tagasi avalehele</a></li>
		<li><a href="/eestifilm">Tagasi Eesti filmi avalehele</a></li>
	</ul>
	<hr>
    <ol>
        <% personList.forEach(function(person) { %>
            <li><%= person.first_name %> <%= person.last_name %>, sündinud <%= person.born.toLocaleDateString('et-EE', {day: '2-digit', month: '2-digit', year: 'numeric'}) %></li>
        <% }); %>
    </ol>

</body>
</html>